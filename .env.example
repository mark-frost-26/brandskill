# ── Database (Neon PostgreSQL) ──────────────────────────────────
DATABASE_URL="postgresql://user:password@host/brandskill?sslmode=require"

# ── NextAuth ────────────────────────────────────────────────────
NEXTAUTH_URL="https://your-repl-name.replit.app"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ── Google OAuth (for NextAuth) ─────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Anthropic (Claude) ──────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ── Stripe ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PREMIUM_PRICE_ID=""     # one-time $19
STRIPE_AGENCY_PRICE_ID=""      # $99/month subscription

# ── Resend (email) ──────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="hello@brandskill.com"

# ── GoHighLevel (optional CRM) ──────────────────────────────────
GHL_API_KEY=""
GHL_LOCATION_ID=""

# ── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-repl-name.replit.app"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
